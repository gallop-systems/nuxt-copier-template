// App-wide settings for gallop-ui (layers/gallop-ui). Looks go under `gallopUi.pt.<Component>`
// (README of the layer, "Customizing").
export default defineAppConfig({
  gallopUi: {
    // The zone times are shown in: formatDateTime, formatTime, formatRelative and DateText.
    // Server and browser read the same value, so they print the same text.
    timeZone: "{{ time_zone }}",
    // The icons the layer's components draw (chevrons, close, check...): "phosphor" or "lucide". Use the same set
    // for the app's own icons (`ph:*` here).
    iconSet: "phosphor",
  },
});
