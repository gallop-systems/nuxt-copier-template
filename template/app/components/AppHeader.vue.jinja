<template>
{%- raw %}
  <header class="border-b border-line bg-surface">
    <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-3">
        <h1 class="text-lg font-semibold text-fg">{{ projectName }}</h1>
      </div>
      <div class="flex items-center gap-4">
        <Avatar v-if="user" :alt="name" />
        <VoltButton v-if="user" label="Log out" severity="secondary" size="small" @click="logout" />
      </div>
    </div>
  </header>
{% endraw -%}
</template>

<script setup lang="ts">
const projectName = "{{ project_name }}";
const { user, clear: logout } = useUserSession();

// <Avatar> shows the initials of `alt`, the person's name.
const name = computed(() =>
  `${user.value?.first_name ?? ""} ${user.value?.last_name ?? ""}`.trim(),
);
</script>
