<template>
{%- raw %}
  <!-- gallop-ui's TopBar: the brand, and the account button whose menu holds the
       Light / Dark / System choice (show-color-scheme, useColorScheme()) and Log out.
       See layers/gallop-ui/components/TopBar/TopBar.md. -->
  <TopBar :title="projectName" :user="account" :menu="menu" show-color-scheme contained />
{% endraw -%}
</template>

<script setup lang="ts">
const projectName = "{{ project_name }}";
const { user, clear: logout } = useUserSession();

// The account button shows the initials of `name`.
const account = computed(() =>
  user.value
    ? {
        name: `${user.value.first_name ?? ""} ${user.value.last_name ?? ""}`.trim(),
        email: user.value.email,
      }
    : null,
);

const menu = [{ label: "Log out", icon: "ph:sign-out", onSelect: () => logout() }];
</script>
