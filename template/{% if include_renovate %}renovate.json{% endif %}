{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Weekend-only schedule (GAL-1004): dependency PRs are batched into Saturday/Sunday so the weekday PR queue stays signal-heavy. The schedule gates branch/PR creation; automergeSchedule is left at its default so a green PR can still merge mid-week after a red-CI fix.",
  "extends": ["config:recommended"],
  "timezone": "America/New_York",
  "schedule": ["every weekend"],
  "lockFileMaintenance": {
    "description": "Replaces :maintainLockFilesWeekly, whose schedule ('before 4am on monday') would let the lockfile PR land on a weekday despite the weekend-only schedule above.",
    "enabled": true,
    "schedule": ["every weekend"]
  },
  "minimumReleaseAge": "2 weeks",
  "internalChecksFilter": "strict",
  "rebaseWhen": "behind-base-branch",
  "copier": { "enabled": false },
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/examples/**",
    "**/__tests__/**",
    "**/test/**",
    "**/tests/**",
    "**/__fixtures__/**",
    "layers/gallop-ui/**"
  ],
  "packageRules": [
    {
      "description": "@gallopsystems/agent-skills is owned by the template and delivered via `copier update` (the template's Renovate bumps it, auto-merges, and cuts a release). This repo must NOT bump it, or the two fight on every template update.",
      "matchPackageNames": ["@gallopsystems/agent-skills"],
      "enabled": false
    },
    {
      "description": "Auto-merge minor/patch updates (prod + dev) once CI passes. CI runs typecheck, the SSR render check, and the test suite, so a broken bump — e.g. a duplicate-transitive-dep type skew that a minor drags in — fails CI and stays open as a red PR for a human; automerge only ever lands green updates. Majors are never matched here, so they always get a manual PR. The kysely group below opts back out.",
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "description": "Bump the kysely ecosystem as one PR. kysely 0.x minors are breaking and kysely-ctl/kysely-codegen pin a kysely range, so splitting them lands a kysely the migration CLI can't import. Not auto-merged: a 0.x minor here can break the query builder or migration CLI in ways CI may not catch, so it keeps a manual review.",
      "matchPackageNames": ["kysely", "kysely-ctl", "kysely-codegen"],
      "groupName": "kysely",
      "automerge": false
    },
    {
      "description": "Exempt lockfile maintenance from the release-age gate and auto-merge it when green. minimumReleaseAge posts a renovate/stability-days status on the weekly lockfile PR that can never clear — the weekly rebase restarts the two-week clock before it expires — so these PRs sat blocked forever despite green CI. Age is already enforced where it matters: yarn's npmMinimalAgeGate quarantines too-new versions at resolution time, covering lockfile maintenance and every other path into the tree. With the redundant gate dropped, the same automerge contract as minor/patch applies: CI green merges, CI red stays open for a human.",
      "matchUpdateTypes": ["lockFileMaintenance"],
      "minimumReleaseAge": null,
      "automerge": true
    }
  ]
}
