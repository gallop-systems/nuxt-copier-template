import { resolveMicrosoftSignIn } from "../../utils/microsoft-auth";

/**
 * nuxt-auth-utils mints the OAuth `state`, stores it in its own
 * `nuxt-auth-state` cookie, and rejects any callback whose returned state does
 * not match, so the CSRF check we used to wrap this handler with is now the
 * provider's job. Wrapping it again breaks the flow: the provider discards the
 * outer state and forwards its own, so the outer comparison can never match.
 */
const microsoftHandler = defineOAuthMicrosoftEventHandler({
  config: {
    scope: ["openid", "profile", "email", "User.Read"],
  },
  async onSuccess(event, { user: msUser }) {
    const result = await resolveMicrosoftSignIn(useDatabase(), msUser);

    if (!result.ok) {
      if (result.error === "no_email") {
        throw createError({
          statusCode: 400,
          message: "No email found in Microsoft account",
        });
      }
      return sendRedirect(event, `/login?error=${result.error}`);
    }

    await setUserSession(event, { user: result.user });

    return sendRedirect(event, "/");
  },
  onError(event, error) {
    console.error("Microsoft OAuth error:", error);
    return sendRedirect(event, "/login?error=auth_failed");
  },
});

/**
 * The provider handler treats "no `code` in the query" as "start authorization",
 * so an error callback — the user cancelling at the Microsoft consent screen
 * sends `?error=access_denied` and no code — would bounce them straight back to
 * Microsoft in a loop. Catch that here and return them to /login instead.
 */
export default defineEventHandler((event) => {
  const query = getQuery(event);

  if (query.error) {
    console.error("Microsoft OAuth error callback:", query.error, query.error_description);
    return sendRedirect(event, "/login?error=auth_failed");
  }

  return microsoftHandler(event);
});
